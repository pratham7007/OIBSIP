<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android App Development"
            android:textColor="#172554"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Choose one of the five standalone assignment screens."
            android:textColor="#475569"
            android:textSize="16sp" />

        <Button android:id="@+id/openConverter" style="@style/LauncherButton" android:text="Unit converter" />
        <Button android:id="@+id/openTodo" style="@style/LauncherButton" android:text="Secure login + to-do list" />
        <Button android:id="@+id/openCalculator" style="@style/LauncherButton" android:text="Calculator" />
        <Button android:id="@+id/openQuiz" style="@style/LauncherButton" android:text="10-question quiz" />
        <Button android:id="@+id/openStopwatch" style="@style/LauncherButton" android:text="Stopwatch + laps" />
    </LinearLayout>
</ScrollView>
