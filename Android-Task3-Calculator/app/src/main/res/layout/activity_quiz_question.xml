<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView android:id="@+id/questionCounter" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Question 1 of 10"
            android:textColor="#2563EB" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/quizQuestion" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:textColor="#172554" android:textSize="23sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/quizOptions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp">
            <RadioButton android:id="@+id/answer0" style="@style/QuizAnswer" />
            <RadioButton android:id="@+id/answer1" style="@style/QuizAnswer" />
            <RadioButton android:id="@+id/answer2" style="@style/QuizAnswer" />
            <RadioButton android:id="@+id/answer3" style="@style/QuizAnswer" />
        </RadioGroup>
        <TextView android:id="@+id/quizFeedback" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textSize="17sp" android:textStyle="bold" />
        <Button android:id="@+id/nextQuestion" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:enabled="false" android:text="Next" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
