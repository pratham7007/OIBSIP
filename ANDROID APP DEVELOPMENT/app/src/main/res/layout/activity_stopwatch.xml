<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Stopwatch" android:textColor="#172554"
        android:textSize="28sp" android:textStyle="bold" />
    <TextView android:id="@+id/stopwatchDisplay" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="30dp"
        android:gravity="center" android:text="00:00:00.000" android:textColor="#172554"
        android:textSize="38sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/startStopwatch" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Start" android:textAllCaps="false" />
        <Button android:id="@+id/pauseStopwatch" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:enabled="false" android:text="Pause" android:textAllCaps="false" />
        <Button android:id="@+id/resetStopwatch" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Reset" android:textAllCaps="false" />
    </LinearLayout>
    <Button android:id="@+id/lapStopwatch" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:enabled="false"
        android:text="Record lap" android:textAllCaps="false" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:text="Laps"
        android:textColor="#172554" android:textSize="18sp" android:textStyle="bold" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <TextView android:id="@+id/lapList" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="8dp"
            android:textColor="#334155" android:textSize="16sp" />
    </ScrollView>
</LinearLayout>
