<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="8dp">
    <CheckBox android:id="@+id/taskComplete" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:buttonTint="#2563EB" android:padding="6dp" />
    <Button android:id="@+id/deleteTask" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:contentDescription="Delete task"
        android:minWidth="48dp" android:text="Delete" android:textAllCaps="false" />
</LinearLayout>
