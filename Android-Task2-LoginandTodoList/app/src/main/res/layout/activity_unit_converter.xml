<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Unit converter" android:textColor="#172554" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Length, weight, and temperature"
            android:textColor="#475569" android:textSize="16sp" />
        <Spinner android:id="@+id/categorySpinner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" />
        <EditText android:id="@+id/valueInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Value to convert"
            android:inputType="numberDecimal|numberSigned" android:selectAllOnFocus="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="From" android:textStyle="bold" />
        <Spinner android:id="@+id/fromSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="To" android:textStyle="bold" />
        <Spinner android:id="@+id/toSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/convertButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="Convert" android:textAllCaps="false" />
        <TextView android:id="@+id/conversionResult" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="Your result will appear here" android:textColor="#172554"
            android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
